// KIKIS - Style Made Simple.
// Fashion Retail Management Platform - Prisma Schema (SQLite)
// Money values are stored as Int (whole Rupiah, IDR has no practical minor unit).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH & PEOPLE ============

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // SUPER_ADMIN | ADMIN | CASHIER
  role         String   @default("CASHIER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions  Transaction[]
  stockMovements StockMovement[]
  auditLogs     AuditLog[]
  shifts        CashierShift[]
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Rumah")
  street     String
  city       String
  province   String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ============ CATALOG ============

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  // Base price in rupiah (variants can override)
  basePrice   Int      @default(0)
  costPrice   Int      @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images   ProductImage[]
  variants ProductVariant[]
  discounts Discount[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

model Size {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)

  variants ProductVariant[]
}

model Color {
  id      String @id @default(cuid())
  name    String @unique
  hexCode String @default("#CCCCCC")

  variants ProductVariant[]
}

// ProductVariant is the primary stock & barcode unit
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId    String?
  size      Size?   @relation(fields: [sizeId], references: [id])
  colorId   String?
  color     Color?  @relation(fields: [colorId], references: [id])
  sku       String  @unique
  barcode   String  @unique
  price     Int
  costPrice Int
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory      Inventory?
  stockMovements StockMovement[]
  transactionItems TransactionItem[]
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]

  @@index([productId])
}

// ============ INVENTORY ============

model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(0)
  minStock  Int            @default(5)
  updatedAt DateTime       @updatedAt
}

// type: PURCHASE | POS_SALE | ONLINE_SALE | CUSTOMER_RETURN | STOCK_ADJUSTMENT | DAMAGED | STOCK_OPNAME
model StockMovement {
  id          String  @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  type        String
  quantity    Int // signed delta: +in / -out
  stockBefore Int
  stockAfter  Int
  reference   String?
  note        String?
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([variantId])
  @@index([type])
  @@index([createdAt])
}

// ============ SUPPLIERS & PURCHASING ============

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Purchase {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  invoiceNo  String   @unique
  total      Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())

  items PurchaseItem[]

  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  unitCost   Int
  subtotal   Int
}

// ============ ONLINE ORDERS ============

// status: PENDING_PAYMENT | WAITING_VERIFICATION | PROCESSING | READY_TO_SHIP | SHIPPED | COMPLETED | CANCELLED
// paymentMethod: TRANSFER | COD | QRIS
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String
  city            String
  province        String
  postalCode      String?
  status          String   @default("PENDING_PAYMENT")
  paymentMethod   String   @default("TRANSFER")
  voucherCode     String?
  subtotal        Int
  voucherDiscount Int      @default(0)
  shippingCost    Int      @default(0)
  total           Int
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String
  variantName String
  sku         String
  // historical price & cost snapshots
  unitPrice   Int
  unitCost    Int
  quantity    Int
  subtotal    Int

  @@index([orderId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  transactionId String?
  // method: TRANSFER | COD | QRIS | CASH
  method        String
  amount        Int
  // status: PENDING | PAID | FAILED | REFUNDED
  status        String   @default("PENDING")
  reference     String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([transactionId])
}

// ============ POS TRANSACTIONS ============

model Transaction {
  id                String   @id @default(cuid())
  transactionNumber String   @unique
  cashierId         String
  cashier           User     @relation(fields: [cashierId], references: [id])
  cashierName       String
  shiftId           String?
  shift             CashierShift? @relation(fields: [shiftId], references: [id])
  subtotal          Int
  // discountType: NONE | FIXED | PERCENT
  discountType      String   @default("NONE")
  discountValue     Int      @default(0)
  discountAmount    Int      @default(0)
  total             Int
  paidAmount        Int
  changeAmount      Int
  // method: CASH | QRIS | DEBIT
  paymentMethod     String   @default("CASH")
  customerName      String?
  note              String?
  createdAt         DateTime @default(now())

  items TransactionItem[]

  @@index([cashierId])
  @@index([createdAt])
}

model TransactionItem {
  id            String          @id @default(cuid())
  transactionId String
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant  @relation(fields: [variantId], references: [id])
  productName   String
  variantName   String
  sku           String
  barcode       String
  // historical price & cost snapshots
  unitPrice     Int
  unitCost      Int
  quantity      Int
  subtotal      Int

  @@index([transactionId])
}

model CashierShift {
  id          String    @id @default(cuid())
  cashierId   String
  cashier     User      @relation(fields: [cashierId], references: [id])
  openingCash Int      @default(0)
  closingCash Int?
  status      String    @default("OPEN") // OPEN | CLOSED
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  transactions Transaction[]

  @@index([cashierId])
}

// ============ PRICING ============

// Product-level discount. type: FIXED | PERCENT
model Discount {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("PERCENT")
  value     Int
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Voucher {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  // FIXED | PERCENT
  type        String   @default("FIXED")
  value       Int
  minPurchase Int      @default(0)
  maxDiscount Int?
  quota       Int      @default(100)
  usedCount   Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============ SYSTEM ============

model StoreSetting {
  id            String   @id @default("main")
  storeName     String   @default("KIKIS")
  tagline       String   @default("Style Made Simple.")
  address       String   @default("")
  phone         String   @default("")
  email         String   @default("")
  receiptFooter String   @default("Terima kasih telah berbelanja di KIKIS")
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String?
  action    String
  entity    String
  entityId  String?
  data      String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}
